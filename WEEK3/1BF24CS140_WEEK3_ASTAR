import heapq

class PuzzleNode:
    def __init__(self, state, parent=None, move="", g=0, h=0):
        self.state = state        # Tuple of 9 integers representing the 3x3 grid
        self.parent = parent      # Pointer to parent node
        self.move = move          # Move made to reach this state
        self.g = g                # Exact path cost from start to current node
        self.h = h                # Heuristic cost (Misplaced tiles) to goal
        self.f = g + h            # Total step cost function: f(n) = g(n) + h(n)

    # Define comparison for the priority queue based on f(n)
    def __lt__(self, other):
        return self.f < other.f

def get_misplaced_tiles(state, goal_state):
    """Calculates the number of misplaced tiles (excluding the blank tile 0)."""
    misplaced = 0
    for i in range(9):
        if state[i] != 0 and state[i] != goal_state[i]:
            misplaced += 1
    return misplaced

def get_neighbors(node, goal_state):
    """Generates valid next states by shifting the blank tile (0)."""
    neighbors = []
    state = node.state
    blank_idx = state.index(0)
    row, col = divmod(blank_idx, 3)

    # Define possible moves: (row_change, col_change, move_name)
    moves = [(-1, 0, "Up"), (1, 0, "Down"), (0, -1, "Left"), (0, 1, "Right")]

    for dr, dc, move_name in moves:
        new_row, new_col = row + dr, col + dc
        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_blank_idx = new_row * 3 + new_col
            
            # Create a new state by swapping tiles
            new_state = list(state)
            new_state[blank_idx], new_state[new_blank_idx] = new_state[new_blank_idx], new_state[blank_idx]
            new_state_tuple = tuple(new_state)
            
            # g(n) increases by 1 for each step
            g_new = node.g + 1
            # h(n) calculated using misplaced tiles
            h_new = get_misplaced_tiles(new_state_tuple, goal_state)
            
            neighbors.append(PuzzleNode(new_state_tuple, node, move_name, g_new, h_new))
            
    return neighbors

def print_grid(state):
    """Helper function to print the 3x3 grid beautifully."""
    for i in range(0, 9, 3):
        print(f" {state[i]} {state[i+1]} {state[i+2]} ")
    print("-" * 11)

def solve_8_puzzle(start_state, goal_state):
    """Solves the 8-puzzle using A* Search Algorithm."""
    open_set = []
    closed_set = {}  # Tracks visited states and their best g(n)

    start_h = get_misplaced_tiles(start_state, goal_state)
    start_node = PuzzleNode(start_state, None, "Start", 0, start_h)
    
    heapq.heappush(open_set, start_node)
    closed_set[start_state] = 0

    while open_set:
        current_node = heapq.heappop(open_set)

        # Goal check
        if current_node.state == goal_state:
            # Reconstruct the path from goal back to start
            path = []
            curr = current_node
            while curr:
                path.append(curr)
                curr = curr.parent
            return path[::-1], current_node.g  # Return ordered path and total cost

        # Explore neighbors
        for neighbor in get_neighbors(current_node, goal_state):
            if neighbor.state not in closed_set or neighbor.g < closed_set[neighbor.state]:
                closed_set[neighbor.state] = neighbor.g
                heapq.heappush(open_set, neighbor)

    return None, -1

def get_row_wise_input(state_name):
    """Prompts the user to enter data row-by-row."""
    print(f"\n--- Enter {state_name} State (Use 0 for blank space) ---")
    state = []
    for i in range(3):
        while True:
            try:
                line = input(f"Enter Row {i+1} (3 numbers separated by spaces): ").strip()
                row_nums = [int(x) for x in line.split()]
                if len(row_nums) == 3:
                    state.extend(row_nums)
                    break
                print("Invalid input! Please enter exactly 3 numbers.")
            except ValueError:
                print("Invalid characters! Please enter numbers only.")
                
    # Validate the full 3x3 grid layout
    if sorted(state) == list(range(9)):
        return tuple(state)
    else:
        print("❌ Error: The state must contain unique digits from 0 to 8. Restarting configuration...")
        return get_row_wise_input(state_name)

if __name__ == "__main__":
    print("=== 8-PUZZLE SOLVER (A* with Misplaced Tiles) ===")
    
    initial = get_row_wise_input("Initial")
    goal = get_row_wise_input("Goal")

    print("\nSolving puzzle... Please wait...\n")
    path, total_cost = solve_8_puzzle(initial, goal)

    if path:
        print(f"🎉 Success! Minimum Path Cost: {total_cost} steps\n")
        print("Step-by-Step Solution Breakdown:")
        for step, node in enumerate(path):
            if step == 0:
                print(f"Step {step}: {node.move} State")
            else:
                print(f"Step {step}: Move [{node.move}]")
            
            print_grid(node.state)
            print(f"📊 Costs -> g(n)={node.g}, h(n)={node.h} | f(n)={node.f}\n")
    else:
        print("❌ No solution exists between the given initial and goal states.")
